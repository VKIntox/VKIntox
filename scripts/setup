#!/usr/bin/env bash
# vkintox remote installer
# usage: curl -fsSL https://buwryy.net/api/vkintox/setup-script | bash

set -euo pipefail

REPO="VKIntox/VKIntox"
RELEASES_URL="${VKINTOX_RELEASES_URL:-https://api.github.com/repos/$REPO/releases?per_page=100}"
EFFECT_PACKAGES_URL="${VKINTOX_EFFECT_PACKAGES_URL:-https://raw.githubusercontent.com/$REPO/refs/heads/main/assets/EffectPackages.ini}"
MARKER_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/VKIntox"
MARKER="$MARKER_DIR/install-state"

METHOD=""
WANT_VERSION=""
LATEST=0
ASSUME_YES=0
DRY_RUN=0
FORCE=0
WANT_EFFECTS=""
APP_ID=""
SYSTEM_KIND=""
RPM_FLAVOR=""
ASSET_GLOB=""
SELECTED_TAG=""
SELECTED_ASSET=""
SELECTED_URL=""
SELECTED_DIGEST=""
TMP_DIR=""
SUDO_PID=""
TTY_SAVED=""

if [[ -t 1 ]]; then
    B='\033[1m'; BLUE='\033[34m'; GREEN='\033[32m'; YELLOW='\033[33m'; RED='\033[31m'; DIM='\033[2m'; NC='\033[0m'
    SPIN_FRAMES=("⠋" "⠙" "⠹" "⠸" "⠼" "⠴" "⠦" "⠧" "⠇" "⠏")
    NAV_HINT=$'\uf0d7\uf0d8'
else
    B=''; BLUE=''; GREEN=''; YELLOW=''; RED=''; DIM=''; NC=''
    SPIN_FRAMES=()
    NAV_HINT=''
fi

spin_pid=""
start_spin() {
    [[ ${#SPIN_FRAMES[@]} -gt 0 ]] || return 0
    local msg="$1"
    (
        local i=0
        while true; do
            printf "\r  ${BLUE}${SPIN_FRAMES[$((i % ${#SPIN_FRAMES[@]}))]}${NC} %s  " "$msg"
            ((i += 1))
            sleep 0.12
        done
    ) &
    spin_pid=$!
    disown "$spin_pid" 2>/dev/null || true
}

stop_spin() {
    if [[ -n "$spin_pid" ]]; then
        kill "$spin_pid" 2>/dev/null || true
        wait "$spin_pid" 2>/dev/null || true
        spin_pid=""
        [[ ! -t 1 ]] || printf '\r\033[K'
    fi
}

say() { stop_spin; printf "${BLUE}  →${NC} %s\n" "$*"; }
ok() { stop_spin; printf "${GREEN}  ✓${NC} %s\n" "$*"; }
warn() { stop_spin; printf "${YELLOW}  !${NC} %s\n" "$*"; }
die() { stop_spin; printf "${RED}  ✗${NC} %s\n" "$*" >&2; exit 1; }
section() { stop_spin; printf "\n${BLUE}${B}%s${NC}\n" "$*"; }
finish() { stop_spin; printf "\n${BLUE}${B}%s${NC}\n" "$*"; }
need_cmd() { command -v "$1" >/dev/null 2>&1 || die "missing $1 — install it first"; }

run_progress() {
    local label="$1" log status
    shift
    log="$TMP_DIR/${label//[^a-zA-Z0-9_-]/_}.log"
    start_spin "$label..."
    if "$@" >"$log" 2>&1; then
        ok "$label"
    else
        status=$?
        stop_spin
        cat "$log" >&2
        die "$label failed (exit $status)"
    fi
}

save_tty() {
    if [[ -t 0 ]]; then
        TTY_SAVED=$(stty -g 2>/dev/null || true)
    elif { exec 3</dev/tty; } 2>/dev/null && [[ -t 3 ]]; then
        TTY_SAVED=$(stty -g <&3 2>/dev/null || true)
        exec 3<&-
    fi
}

restore_tty() {
    [[ -n "$TTY_SAVED" ]] || return 0
    if [[ -t 0 ]]; then
        stty "$TTY_SAVED" 2>/dev/null || true
    elif { exec 3</dev/tty; } 2>/dev/null && [[ -t 3 ]]; then
        stty "$TTY_SAVED" <&3 2>/dev/null || true
        exec 3<&-
    fi
}

start_sudo() {
    [[ -z "$SUDO_PID" ]] || return 0
    ( while true; do sudo -n true 2>/dev/null || exit; sleep 50; done ) &
    SUDO_PID=$!
    disown "$SUDO_PID" 2>/dev/null || true
}

stop_sudo() {
    if [[ -n "$SUDO_PID" ]]; then
        kill "$SUDO_PID" 2>/dev/null || true
        wait "$SUDO_PID" 2>/dev/null || true
        SUDO_PID=""
    fi
}

cleanup() {
    local status=$?
    trap - EXIT HUP INT TERM
    restore_tty
    stop_sudo
    if [[ -n "${TMP_DIR:-}" && -d "$TMP_DIR" ]]; then
        rm -rf -- "$TMP_DIR"
    fi
    stop_spin
    exit "$status"
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

usage() {
    cat <<'EOF'
usage:
  curl -fsSL https://buwryy.net/api/vkintox/setup-script | bash
  curl -fsSL https://buwryy.net/api/vkintox/setup-script | bash -s -- --system --latest --yes
  curl -fsSL https://buwryy.net/api/vkintox/setup-script | bash -s -- --flatpak --app org.vinegarhq.Sober --version v0.2.0 --yes

options:
  --system, --flatpak   skip the install-method prompt
  --app <id>            flatpak app id to enable the layer for
  --version <tag>       pick an exact release (e.g. v0.2.0)
  --latest              skip the version prompt and take the recommended release
  --effects             fetch ReShade effects and textures without asking
  --no-effects          skip ReShade effects and textures
  --yes, -y             skip the confirmation prompt
  --reinstall           install the layer even when the marker matches
  --dry-run             print what would be downloaded and installed
EOF
}

while (($#)); do
    case "$1" in
        --system) METHOD=system; shift ;;
        --flatpak) METHOD=flatpak; shift ;;
        --app)
            (($# >= 2)) || die "--app needs a value"
            APP_ID="$2"
            shift 2
            ;;
        --version)
            (($# >= 2)) || die "--version needs a value"
            WANT_VERSION="$2"
            shift 2
            ;;
        --latest) LATEST=1; shift ;;
        --effects) WANT_EFFECTS=yes; shift ;;
        --no-effects) WANT_EFFECTS=no; shift ;;
        --yes | -y) ASSUME_YES=1; shift ;;
        --reinstall) FORCE=1; shift ;;
        --dry-run) DRY_RUN=1; shift ;;
        -h | --help) usage; exit 0 ;;
        *) die "unknown option: $1" ;;
    esac
done
[[ -z "$WANT_VERSION" || "$LATEST" -eq 0 ]] || die "--version and --latest cannot be combined"
[[ "$METHOD" != "system" || -z "$APP_ID" ]] || die "--app is only valid with --flatpak"

select_menu() {
    local prompt="$1"
    shift
    local -a labels=("$@")
    local count=${#labels[@]}
    local cursor=0 drawn=0 index key rest read_fd=0
    SELECTED=0
    ((count > 0)) || return 0

    if [[ ! -t 0 ]]; then
        if exec 3</dev/tty 2>/dev/null && [[ -t 3 ]]; then
            read_fd=3
        else
            die "this step needs a terminal; use --system or --flatpak plus --version or --latest, and --yes"
        fi
    fi
    need_cmd stty
    stty -icanon min 1 time 0 -echo <&"$read_fd" 2>/dev/null || true
    printf '\n'

    while true; do
        if ((drawn > 0)); then
            printf '\033[%dA' "$drawn"
        fi
        printf "\r\033[K${B}%s${NC} ${DIM}%s${NC}\n" "$prompt" "$NAV_HINT"
        for ((index = 0; index < count; index++)); do
            if ((index == cursor)); then
                printf "\r\033[K  ${BLUE}${B}>${NC} %b\n" "${labels[index]}"
            else
                printf "\r\033[K    %b\n" "${labels[index]}"
            fi
        done
        drawn=$((count + 1))

        key=""
        IFS= read -rsn1 -u "$read_fd" key || true
        [[ -n "$key" ]] || break
        if [[ "$key" == $'\e' || "$key" == $'\033' ]]; then
            rest=""
            IFS= read -rsn2 -u "$read_fd" rest || true
            case "$rest" in
                '[A' | 'OA') cursor=$(((cursor - 1 + count) % count)) ;;
                '[B' | 'OB') cursor=$(((cursor + 1) % count)) ;;
            esac
            continue
        fi
        case "$key" in
            $'\r' | $'\n') break ;;
            $'\003' | $'\004') die "aborted" ;;
        esac
    done

    restore_tty
    if ((read_fd == 3)); then exec 3<&-; fi

    printf '\033[%dA' "$drawn"
    for ((index = 0; index < drawn; index++)); do
        printf '\r\033[K\n'
    done
    printf '\033[%dA' "$drawn"
    printf "  ${GREEN}✓${NC} %b\n" "${labels[$cursor]}"
    SELECTED=$cursor
}

confirm() {
    ((ASSUME_YES)) && return 0
    local fd=0
    if [[ ! -t 0 ]]; then
        if exec 3</dev/tty 2>/dev/null && [[ -t 3 ]]; then
            fd=3
        else
            die "confirmation needs a terminal; pass --yes for unattended installs"
        fi
    fi
    IFS= read -r -u "$fd" _ || die "aborted"
    if ((fd == 3)); then exec 3<&-; fi
}

detect_system() {
    local arch id like
    arch="$(uname -m)"
    [[ "$arch" == "x86_64" ]] || die "vkintox is x86_64 only (this machine is $arch)"
    id=""
    like=""
    if [[ -r /etc/os-release ]]; then
        id="$(sed -n 's/^ID=//p' /etc/os-release | tr -d '"')"
        like="$(sed -n 's/^ID_LIKE=//p' /etc/os-release | tr -d '"')"
    fi
    case " $id $like " in
        *" arch "*) SYSTEM_KIND=arch ;;
        *" debian "* | *" ubuntu "*) SYSTEM_KIND=deb ;;
        *" suse "* | *" opensuse "*) SYSTEM_KIND=rpm; RPM_FLAVOR=suse ;;
        *" fedora "* | *" rhel "* | *" centos "*) SYSTEM_KIND=rpm; RPM_FLAVOR=fedora ;;
        *)
            if command -v pacman >/dev/null 2>&1; then
                SYSTEM_KIND=arch
            elif command -v apt-get >/dev/null 2>&1; then
                SYSTEM_KIND=deb
            elif command -v zypper >/dev/null 2>&1; then
                SYSTEM_KIND=rpm; RPM_FLAVOR=suse
            elif command -v dnf >/dev/null 2>&1 || command -v yum >/dev/null 2>&1; then
                SYSTEM_KIND=rpm; RPM_FLAVOR=fedora
            else
                die "system-wide installs are available for Fedora/openSUSE, Debian/Ubuntu and Arch; use --flatpak instead"
            fi
            ;;
    esac
    case "$SYSTEM_KIND" in
        rpm) ASSET_GLOB='*.x86_64.rpm' ;;
        deb) ASSET_GLOB='*_amd64.deb' ;;
        arch) ASSET_GLOB='*x86_64.pkg.tar.zst' ;;
    esac
}

select_flatpak_app() {
    need_cmd flatpak
    if [[ -n "$APP_ID" ]]; then
        flatpak list --app --columns=application 2>/dev/null | grep -qx "$APP_ID" ||
            die "flatpak app $APP_ID is not installed"
        return 0
    fi

    local -a ids=() names=() labels=()
    while IFS=$'\t' read -r id name; do
        [[ -n "$id" ]] || continue
        ids+=("$id")
        names+=("$name")
    done < <(flatpak list --app --columns=application,name 2>/dev/null)
    ((${#ids[@]})) || die "no flatpak apps are installed; install one first or use --system"

    local -a order_ids=() order_labels=()
    local preferred id index found
    for preferred in org.vinegarhq.Sober net.buwryy.Roseline; do
        found=0
        for index in "${!ids[@]}"; do
            if [[ "${ids[$index]}" == "$preferred" ]]; then
                order_ids+=("$preferred")
                order_labels+=("${GREEN}${preferred}${NC} (${names[$index]})")
                found=1
                break
            fi
        done
        ((found)) || true
    done
    local -a rest=()
    for id in "${ids[@]}"; do
        [[ "$id" == "org.vinegarhq.Sober" || "$id" == "net.buwryy.Roseline" ]] && continue
        rest+=("$id")
    done
    if ((${#rest[@]})); then
        mapfile -t rest < <(printf '%s\n' "${rest[@]}" | LC_ALL=C sort)
        for id in "${rest[@]}"; do
            for index in "${!ids[@]}"; do
                if [[ "${ids[$index]}" == "$id" ]]; then
                    order_ids+=("$id")
                    order_labels+=("$id (${names[$index]})")
                    break
                fi
            done
        done
    fi

    select_menu "which flatpak app should use vkintox?" "${order_labels[@]}"
    APP_ID="${order_ids[$SELECTED]}"
}

fetch_releases() {
    local http
    start_spin "fetching releases..."
    http=$(curl -sSL -w '%{http_code}' \
        -H 'Accept: application/vnd.github+json' \
        -H 'X-GitHub-Api-Version: 2022-11-28' \
        "${AUTH_ARGS[@]}" \
        "$RELEASES_URL" -o "$TMP_DIR/releases.json" || true)
    stop_spin
    case "$http" in
        200) ;;
        403) die "GitHub API rate limit hit (HTTP 403); set GH_TOKEN or wait and retry" ;;
        404) die "no vkintox releases were found" ;;
        *) die "couldn't fetch releases (HTTP ${http:-no response})" ;;
    esac
    jq -e 'type == "array" and length > 0' "$TMP_DIR/releases.json" >/dev/null 2>&1 ||
        die "no vkintox releases are published yet"
}

REL_TAG=() REL_BASE=() REL_CAT=() REL_HOTFIX=() REL_DATE=() REL_ASSET=() REL_URL=() REL_DIGEST=()
declare -A BEST_IDX=()
ORDERED_BASES=() VERSION_LABELS=() STABLE_BASES=() PREFIX_BASES=()

load_releases() {
    local tag date name url digest base suffix category hotfix
    local -A seen=()
    REL_TAG=() REL_BASE=() REL_CAT=() REL_HOTFIX=() REL_DATE=() REL_ASSET=() REL_URL=() REL_DIGEST=()
    while IFS=$'\t' read -r tag date name url digest; do
        [[ -n "$tag" && -n "$name" ]] || continue
        # shellcheck disable=SC2254
        case "$name" in
            $ASSET_GLOB) ;;
            *) continue ;;
        esac
        if [[ "$METHOD" == "system" && "$SYSTEM_KIND" == "rpm" ]]; then
            if [[ "$RPM_FLAVOR" == "fedora" ]]; then
                [[ "$name" == *".fc"*".x86_64.rpm" ]] || continue
            else
                [[ "$name" != *".fc"* ]] || continue
            fi
        fi
        [[ -z "${seen[$tag]:-}" ]] || continue
        [[ "$tag" =~ ^v?([0-9]+(\.[0-9]+)+)(-(.+))?$ ]] || continue
        base="${BASH_REMATCH[1]}"
        suffix="${BASH_REMATCH[4]:-}"
        category=0
        hotfix=0
        if [[ -z "$suffix" ]]; then
            category=1
        elif [[ "$suffix" =~ ^(hotfix|hf)([.-]?([0-9]+))?$ ]]; then
            category=2
            hotfix=$((10#${BASH_REMATCH[3]:-1}))
        fi
        seen[$tag]=1
        REL_TAG+=("$tag")
        REL_BASE+=("$base")
        REL_CAT+=("$category")
        REL_HOTFIX+=("$hotfix")
        REL_DATE+=("$date")
        REL_ASSET+=("$name")
        REL_URL+=("$url")
        REL_DIGEST+=("$digest")
    done < <(jq -r '
        .[] | select(.draft | not) as $r
        | $r.assets[]?
        | [$r.tag_name, ($r.published_at // $r.created_at // ""), .name, .browser_download_url, (.digest // "")]
        | @tsv
    ' "$TMP_DIR/releases.json")
    if ((${#REL_TAG[@]} == 0)); then
        if [[ "$METHOD" == "system" ]]; then
            die "no native packages for $SYSTEM_KIND were found in the releases; try --flatpak"
        fi
        die "no Flatpak packages were found in the releases"
    fi
}

choose_releases() {
    local i base category hotfix date
    local -A best_cat=() best_hot=() best_date=() best_idx=()
    for i in "${!REL_TAG[@]}"; do
        base="${REL_BASE[$i]}"
        category="${REL_CAT[$i]}"
        hotfix="${REL_HOTFIX[$i]}"
        date="${REL_DATE[$i]}"
        if [[ -z "${best_idx[$base]:-}" ]]; then
            best_cat[$base]=$category
            best_hot[$base]=$hotfix
            best_date[$base]=$date
            best_idx[$base]=$i
            continue
        fi
        if ((category > best_cat[$base])) ||
            ((category == best_cat[$base] && hotfix > best_hot[$base])); then
            best_cat[$base]=$category
            best_hot[$base]=$hotfix
            best_date[$base]=$date
            best_idx[$base]=$i
        elif ((category == best_cat[$base] && hotfix == best_hot[$base])) &&
            [[ "$date" > "${best_date[$base]}" ]]; then
            best_date[$base]=$date
            best_idx[$base]=$i
        fi
    done
    BEST_IDX=()
    for base in "${!best_idx[@]}"; do
        BEST_IDX[$base]="${best_idx[$base]}"
    done
}

build_versions() {
    local base index idx label
    STABLE_BASES=()
    PREFIX_BASES=()
    for base in "${!BEST_IDX[@]}"; do
        idx="${BEST_IDX[$base]}"
        if ((REL_CAT[idx] >= 1)); then
            STABLE_BASES+=("$base")
        else
            PREFIX_BASES+=("$base")
        fi
    done
    if ((${#STABLE_BASES[@]})); then
        mapfile -t STABLE_BASES < <(printf '%s\n' "${STABLE_BASES[@]}" | sort -Vr)
    fi
    if ((${#PREFIX_BASES[@]})); then
        mapfile -t PREFIX_BASES < <(printf '%s\n' "${PREFIX_BASES[@]}" | sort -Vr)
    fi
    ORDERED_BASES=()
    if ((${#STABLE_BASES[@]})); then ORDERED_BASES+=("${STABLE_BASES[@]}"); fi
    if ((${#PREFIX_BASES[@]})); then ORDERED_BASES+=("${PREFIX_BASES[@]}"); fi
    ((${#ORDERED_BASES[@]})) || die "no installable versions were found"

    VERSION_LABELS=()
    for index in "${!ORDERED_BASES[@]}"; do
        base="${ORDERED_BASES[$index]}"
        idx="${BEST_IDX[$base]}"
        label="${REL_TAG[$idx]}"
        if ((REL_CAT[idx] == 0)); then
            label="${YELLOW}${label} (pre-release)${NC}"
        elif ((index == 0)); then
            label="${GREEN}${label} (recommended)${NC}"
        fi
        VERSION_LABELS+=("$label")
    done
}

choose_version() {
    local want want_base i base idx
    if [[ -n "$WANT_VERSION" ]]; then
        want="${WANT_VERSION#v}"
        for i in "${!REL_TAG[@]}"; do
            if [[ "${REL_TAG[$i]#v}" == "$want" ]]; then
                SELECTED_TAG="${REL_TAG[$i]}"
                SELECTED_ASSET="${REL_ASSET[$i]}"
                SELECTED_URL="${REL_URL[$i]}"
                SELECTED_DIGEST="${REL_DIGEST[$i]}"
                return 0
            fi
        done
        want_base="${want%%-*}"
        for base in "${ORDERED_BASES[@]}"; do
            if [[ "$base" == "$want_base" ]]; then
                idx="${BEST_IDX[$base]}"
                SELECTED_TAG="${REL_TAG[$idx]}"
                SELECTED_ASSET="${REL_ASSET[$idx]}"
                SELECTED_URL="${REL_URL[$idx]}"
                SELECTED_DIGEST="${REL_DIGEST[$idx]}"
                return 0
            fi
        done
        die "version $WANT_VERSION is not available for $METHOD"
    fi
    if ((LATEST)); then
        base="${ORDERED_BASES[0]}"
        idx="${BEST_IDX[$base]}"
    else
        select_menu "choose a version" "${VERSION_LABELS[@]}"
        base="${ORDERED_BASES[$SELECTED]}"
        idx="${BEST_IDX[$base]}"
    fi
    SELECTED_TAG="${REL_TAG[$idx]}"
    SELECTED_ASSET="${REL_ASSET[$idx]}"
    SELECTED_URL="${REL_URL[$idx]}"
    SELECTED_DIGEST="${REL_DIGEST[$idx]}"
}

marker_matches() {
    [[ -f "$MARKER" ]] || return 1
    local tag asset digest method app
    tag=$(sed -n 's/^tag=//p' "$MARKER" | head -1)
    asset=$(sed -n 's/^asset=//p' "$MARKER" | head -1)
    digest=$(sed -n 's/^digest=//p' "$MARKER" | head -1)
    method=$(sed -n 's/^method=//p' "$MARKER" | head -1)
    app=$(sed -n 's/^app_id=//p' "$MARKER" | head -1)
    [[ "$tag" == "$SELECTED_TAG" && "$asset" == "$SELECTED_ASSET" && "$method" == "$METHOD" ]] || return 1
    [[ -z "$SELECTED_DIGEST" || "$digest" == "${SELECTED_DIGEST#sha256:}" ]] || return 1
    if [[ "$METHOD" == "flatpak" ]]; then
        [[ "$app" == "$APP_ID" ]] || return 1
    fi
    return 0
}

installed_pkg_version() {
    case "$SYSTEM_KIND" in
        rpm) rpm -q --qf '%{VERSION}' vkintox 2>/dev/null ;;
        deb) dpkg-query -W -f='${Version}' vkintox 2>/dev/null ;;
        arch) pacman -Q vkintox 2>/dev/null | awk '{print $2}' ;;
    esac
}

write_marker() {
    mkdir -p "$MARKER_DIR"
    {
        printf 'tag=%s\n' "$SELECTED_TAG"
        printf 'asset=%s\n' "$SELECTED_ASSET"
        printf 'digest=%s\n' "${SELECTED_DIGEST#sha256:}"
        printf 'method=%s\n' "$METHOD"
        printf 'app_id=%s\n' "$APP_ID"
    } >"$MARKER"
}

validate_asset() {
    case "$SYSTEM_KIND" in
        rpm)
            command -v rpm >/dev/null 2>&1 || return 0
            rpm -qp "$ASSET_PATH" >/dev/null 2>&1 || die "the downloaded file is not a valid RPM"
            ;;
        deb)
            command -v dpkg-deb >/dev/null 2>&1 || return 0
            dpkg-deb --info "$ASSET_PATH" >/dev/null 2>&1 || die "the downloaded file is not a valid deb"
            ;;
        *) ;;
    esac
}

google_font_url() {
    local family="$1" spec="${2:-}" css
    css=$(curl -fsSL -A "Mozilla/4.0" \
        "https://fonts.googleapis.com/css2?family=${family}${spec:+:$spec}" 2>/dev/null) || css=""
    printf '%s\n' "$css" | grep -om1 'https://[^)]*\.ttf' || true
}

repo_font_url() {
    curl -fsSL "${AUTH_ARGS[@]}" \
        "https://api.github.com/repos/google/fonts/contents/ofl/$1" 2>/dev/null |
        jq -r '[.[]? | select(.name | test("\\.ttf$"))] | .[0].download_url // empty' 2>/dev/null || true
}

is_font_file() {
    local magic
    magic=$(head -c 4 "$1" 2>/dev/null | od -An -tx1 | tr -d ' \n')
    case "$magic" in
        00010000 | 4f54544f | 74727565) return 0 ;;
        *) return 1 ;;
    esac
}

font_installed() {
    [[ -s "$APP_CONFIG/font/$1" ]] && is_font_file "$APP_CONFIG/font/$1"
}

seed_google_font() {
    local dest="$1"
    shift
    local url
    for url in "$@"; do
        [[ -n "$url" ]] || continue
        if curl -fsSL "$url" -o "$APP_CONFIG/font/$dest" 2>/dev/null &&
            [[ -s "$APP_CONFIG/font/$dest" ]] && is_font_file "$APP_CONFIG/font/$dest"; then
            return 0
        fi
        rm -f "$APP_CONFIG/font/$dest"
    done
    warn "couldn't fetch $dest; leaving the overlay's fallback in place"
    return 1
}

seed_google_license() {
    local dir="$1" dest="$2"
    [[ -s "$APP_CONFIG/font/$dest" ]] && return 0
    curl -fsSL "https://raw.githubusercontent.com/google/fonts/main/ofl/$dir/OFL.txt" \
        -o "$APP_CONFIG/font/$dest" 2>/dev/null || rm -f "$APP_CONFIG/font/$dest"
    return 0
}

seed_fonts() {
    font_installed RobotoFlex.ttf || seed_google_font RobotoFlex.ttf "$(repo_font_url robotoflex)" || true
    font_installed GoogleSansFlex.ttf || seed_google_font GoogleSansFlex.ttf "$(repo_font_url googlesansflex)" \
        "$(google_font_url "Google+Sans+Flex")" || true
    font_installed MaterialSymbolsRounded.ttf || seed_google_font MaterialSymbolsRounded.ttf "$(google_font_url "Material+Symbols+Rounded" "wght@400")" || true
    font_installed MaterialSymbolsRoundedBold.ttf ||
        seed_google_font MaterialSymbolsRoundedBold.ttf \
            "$(google_font_url "Material+Symbols+Rounded" "wght@700")" \
            "$(google_font_url "Material+Symbols+Rounded" "wght@400")" || true
    [[ -s "$APP_CONFIG/font/MaterialSymbolsRoundedBold.ttf" ]] ||
        cp "$APP_CONFIG/font/MaterialSymbolsRounded.ttf" "$APP_CONFIG/font/MaterialSymbolsRoundedBold.ttf" 2>/dev/null || true
    seed_google_license robotoflex LICENSE-SIL-OFL-1.1.txt
    seed_google_license materialsymbolsrounded LICENSE-Apache-2.0.txt
    [[ -s "$APP_CONFIG/font/RobotoFlex.ttf" ]] && cp "$APP_CONFIG/font/RobotoFlex.ttf" "$APP_CONFIG/font/font.ttf"
}

effects_current() {
    [[ -f "$EFFECTS_MARKER" && -f "$TMP_DIR/EffectPackages.ini" ]] || return 1
    [[ "$(cat "$EFFECTS_MARKER")" == "$(sha256sum "$TMP_DIR/EffectPackages.ini" | cut -d' ' -f1)" ]]
}

install_effects() {
    local effects_hash
    effects_hash=$(sha256sum "$TMP_DIR/EffectPackages.ini" | cut -d' ' -f1)
    say "downloading + extracting packages"
    rm -rf "$SHADERS_DIR" "$TEXTURES_DIR"
    mkdir -p "$SHADERS_DIR" "$TEXTURES_DIR"
    rm -rf "$RESHADE_DIR/packages"
    python3 - "$TMP_DIR" "$SHADERS_DIR" "$TEXTURES_DIR" "$TMP_DIR/EffectPackages.ini" <<'PYEOF'
import configparser, os, sys, shutil, urllib.request, zipfile

work_dir, shaders_dir, textures_dir, ini_file = sys.argv[1:5]
with open(ini_file, "r", encoding="utf-8-sig") as f:
    cfg = configparser.ConfigParser(strict=False)
    cfg.read_string(f.read())

failed = []
ok = 0
for section in cfg.sections():
    pkg = cfg[section]
    name = pkg.get("PackageName", section)
    url = pkg.get("DownloadUrl")
    if not url:
        continue

    def package_dir(configured, root, fallback):
        path = (configured or "").replace("\\", "/")
        marker = "reshade-shaders/" + root
        sub = path.split(marker, 1)[1].strip("/") if marker in path else ""
        sub = sub or fallback
        sub = "".join(c if (c.isalnum() or c in "-_.") else "_" for c in sub).strip("._")
        return sub or "package"

    fallback_dir = (pkg.get("PackageName", section).split() or [section])[0]
    sub_shader = package_dir(pkg.get("InstallPath"), "Shaders", fallback_dir)
    sub_tex = package_dir(pkg.get("TextureInstallPath"), "Textures", sub_shader)
    tgt_shaders = os.path.join(shaders_dir, sub_shader)
    tgt_textures = os.path.join(textures_dir, sub_tex)
    os.makedirs(tgt_shaders, exist_ok=True)
    os.makedirs(tgt_textures, exist_ok=True)
    effect_files = {f.strip() for f in pkg.get("EffectFiles", "").split(",") if f.strip()}
    deny_files = {f.strip() for f in pkg.get("DenyEffectFiles", "").split(",") if f.strip()}
    zip_path = os.path.join(work_dir, f"{section}.zip")
    try:
        req = urllib.request.Request(url, headers={"User-Agent": "VKIntox-setup"})
        with urllib.request.urlopen(req) as response, open(zip_path, "wb") as out:
            shutil.copyfileobj(response, out)
        extract_dir = os.path.join(work_dir, section)
        with zipfile.ZipFile(zip_path) as archive:
            archive.extractall(extract_dir)
    except Exception as exc:
        failed.append(f"{name} ({exc})")
        continue
    shader_count = texture_count = 0
    for root, _, files in os.walk(extract_dir):
        for filename in files:
            if filename in deny_files:
                continue
            source = os.path.join(root, filename)
            if filename.endswith((".fx", ".fxh")):
                if filename.endswith(".fx") and effect_files and filename not in effect_files:
                    continue
                shutil.copy2(source, tgt_shaders)
                shader_count += 1
            elif filename.lower().endswith((".png", ".jpg", ".jpeg", ".dds", ".tga", ".bmp")):
                shutil.copy2(source, tgt_textures)
                texture_count += 1
    if shader_count + texture_count == 0:
        failed.append(f"{name} (no matching files)")
    else:
        ok += 1
        print(f"  ✓ {name}: {shader_count} shader(s), {texture_count} texture(s)")

print(f"\n  {ok} package(s) installed")
if failed:
    print("  Packages with problems:")
    for problem in failed:
        print(f"    - {problem}")
    raise SystemExit(1)
PYEOF
    printf '%s\n' "$effects_hash" >"$EFFECTS_MARKER"
}

TMP_DIR=$(mktemp -d)
save_tty

need_cmd curl
need_cmd jq
need_cmd uname
need_cmd sed
need_cmd sort
need_cmd tr
need_cmd grep
need_cmd awk
need_cmd mktemp

AUTH_ARGS=()
if [[ -n "${GITHUB_TOKEN:-${GH_TOKEN:-}}" ]]; then
    AUTH_ARGS=(-H "Authorization: Bearer ${GITHUB_TOKEN:-$GH_TOKEN}")
fi

section "vkintox setup"
say "vulkan post-processing layer with an in-game overlay"

if [[ -z "$METHOD" ]]; then
    select_menu "would you like to install vkintox system-wide, or via flatpak?" "system-wide" "flatpak"
    if ((SELECTED == 0)); then
        METHOD=system
    else
        METHOD=flatpak
    fi
fi

if [[ "$METHOD" == "system" ]]; then
    detect_system
else
    ASSET_GLOB='*.flatpak'
    select_flatpak_app
fi

fetch_releases
load_releases
choose_releases
build_versions
choose_version

SKIP_LAYER=0
if ((FORCE == 0)); then
    if marker_matches; then
        SKIP_LAYER=1
    elif [[ "$METHOD" == "system" ]]; then
        installed_version=$(installed_pkg_version || true)
        if [[ -n "$installed_version" && "${installed_version%%-*}" == "${SELECTED_TAG#v}" ]]; then
            SKIP_LAYER=1
        fi
    fi
fi

section "confirm"
printf "  version: %s\n" "$SELECTED_TAG"
printf "  package: %s\n" "$SELECTED_ASSET"
if ((SKIP_LAYER)); then
    printf "  layer: already installed\n"
fi
if [[ "$METHOD" == "flatpak" ]]; then
    printf "  app: %s\n" "$APP_ID"
fi
printf '  %bpress enter to confirm%b\n' "$DIM" "$NC"
confirm
ok "confirmed"

ASSET_PATH="$TMP_DIR/$SELECTED_ASSET"

if ((SKIP_LAYER)); then
    ok "layer is already installed from $SELECTED_TAG"
    write_marker
else
    if [[ "$METHOD" == "system" ]]; then
        section "sudo"
        if ((DRY_RUN)); then
            say "dry run: sudo would be requested"
        elif ((EUID == 0)); then
            ok "running as root; no sudo needed"
        else
            say "sudo is needed to install the package"
            sudo -v || die "sudo was not granted"
            start_sudo
            ok "sudo ready"
        fi
    else
        section "permissions"
        say "flatpak installs into your user account; no sudo needed"
        ok "ready"
    fi

    if ((DRY_RUN)); then
        say "dry run: would download $SELECTED_URL"
    else
        section "download"
        run_progress "downloading $SELECTED_ASSET" curl -fL --retry 3 --retry-delay 1 \
            -o "$ASSET_PATH" "$SELECTED_URL"
        [[ -s "$ASSET_PATH" ]] || die "the downloaded package is empty"
        if [[ -n "$SELECTED_DIGEST" ]]; then
            actual=$(sha256sum "$ASSET_PATH" | cut -d' ' -f1)
            [[ "$actual" == "${SELECTED_DIGEST#sha256:}" ]] || die "checksum mismatch for $SELECTED_ASSET"
        fi
        validate_asset
    fi

    if [[ "$METHOD" == "system" ]]; then
        case "$SYSTEM_KIND" in
            rpm)
                if [[ "$RPM_FLAVOR" == "suse" ]]; then
                    INSTALL_CMD=(zypper --non-interactive --no-gpg-checks install "$ASSET_PATH")
                elif command -v dnf >/dev/null 2>&1; then
                    INSTALL_CMD=(dnf install -y --nogpgcheck "$ASSET_PATH")
                else
                    INSTALL_CMD=(yum install -y --nogpgcheck "$ASSET_PATH")
                fi
                ;;
            deb)
                INSTALL_CMD=(env DEBIAN_FRONTEND=noninteractive apt-get install -y "$ASSET_PATH")
                ;;
            arch)
                INSTALL_CMD=(pacman -U --noconfirm "$ASSET_PATH")
                ;;
        esac
        if ((EUID != 0)); then
            INSTALL_CMD=(sudo "${INSTALL_CMD[@]}")
        fi
        if ((DRY_RUN)); then
            say "dry run: would install with: ${INSTALL_CMD[*]}"
        else
            section "install"
            run_progress "installing vkintox $SELECTED_TAG" "${INSTALL_CMD[@]}"
            ok "installed"
        fi
    else
        FLATPAK_CMD=(flatpak install --user --noninteractive -y "$ASSET_PATH")
        if ((DRY_RUN)); then
            say "dry run: would install with: ${FLATPAK_CMD[*]}"
        else
            section "install"
            run_progress "installing vkintox $SELECTED_TAG" "${FLATPAK_CMD[@]}"
            if ! flatpak override --user "$APP_ID" --env=ENABLE_VKINTOX=1 2>/dev/null; then
                warn "couldn't set ENABLE_VKINTOX for $APP_ID"
            fi
            if [[ "$APP_ID" == "io.github.microlift.butter" ]]; then
                flatpak override --user "$APP_ID" --env=GSK_RENDERER=gl 2>/dev/null || true
            fi
            ok "installed"
        fi
    fi
    if ((DRY_RUN == 0)); then
        write_marker
    fi
fi

if [[ "$METHOD" == "flatpak" ]]; then
    APP_CONFIG="$HOME/.var/app/$APP_ID/config/VKIntox"
else
    APP_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/VKIntox"
fi
RESHADE_DIR="$APP_CONFIG/reshade"
SHADERS_DIR="$RESHADE_DIR/Shaders"
TEXTURES_DIR="$RESHADE_DIR/Textures"
EFFECTS_MARKER="$RESHADE_DIR/.vkintox_effects_hash"

section "config dirs"
mkdir -p "$SHADERS_DIR" "$TEXTURES_DIR" "$APP_CONFIG/font"
curl -fsSL "https://raw.githubusercontent.com/$REPO/main/VERSION" -o "$APP_CONFIG/version" 2>/dev/null || true
seed_fonts
ok "created config dirs"

section "reshade effects"
curl -fsSL "$EFFECT_PACKAGES_URL" -o "$TMP_DIR/EffectPackages.ini" 2>/dev/null || true
if [[ ! -s "$TMP_DIR/EffectPackages.ini" ]]; then
    warn "couldn't fetch EffectPackages.ini; skipping effects"
    WANT_EFFECTS=no
elif effects_current; then
    ok "effects up to date"
    WANT_EFFECTS=no
fi

if [[ -z "$WANT_EFFECTS" ]]; then
    if [[ -t 0 || -r /dev/tty ]]; then
        select_menu "fetch ReShade effects and textures?" "yes" "no"
        if ((SELECTED == 0)); then WANT_EFFECTS=yes; else WANT_EFFECTS=no; fi
    else
        WANT_EFFECTS=yes
    fi
fi

if [[ "$WANT_EFFECTS" == "yes" ]]; then
    if effects_current; then
        ok "effects up to date"
    elif ((DRY_RUN)); then
        say "dry run: would download ReShade effects and textures"
    else
        need_cmd python3
        install_effects
        ok "effects installed"
    fi
else
    say "skipping ReShade effects and textures"
fi

if ((DRY_RUN)); then
    finish "dry run complete"
    say "nothing was installed"
else
    finish "vkintox is installed"
    if [[ "$METHOD" == "flatpak" ]]; then
        say "launch it with: flatpak run $APP_ID"
    else
        say "enable it with: ENABLE_VKINTOX=1 <game>"
    fi
fi
