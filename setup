#!/usr/bin/env bash
# vkintox installer
# usage: ./setup sober | ./setup flatpak APP_ID | ./setup system

set -euo pipefail

usage() {
    cat <<'EOF'
usage:
  ./setup sober              build + install layer/shaders for sober
  ./setup flatpak APP_ID     build + configure layer for a flatpak app
  ./setup system             build + install system-wide

  ./setup sober uninstall    remove the layer, keep your config
  ./setup flatpak uninstall  remove the layer, keep your config
  ./setup system uninstall   remove the system-wide install
EOF
}

if [[ -t 1 ]]; then
    B='\033[1m'; BLUE='\033[34m'; GREEN='\033[32m'; YELLOW='\033[33m'
    RED='\033[31m'; DIM='\033[2m'; NC='\033[0m'
    # Six-dot Braille spinner, cycling a lit dot around a 2x3 cell.
    SPIN_FRAMES=("⠋" "⠙" "⠹" "⠸" "⠼" "⠴" "⠦" "⠧" "⠇" "⠏")
else
    B=''; BLUE=''; GREEN=''; YELLOW=''; RED=''; DIM=''; NC=''
    SPIN_FRAMES=()
fi

LAYER_ID="org.freedesktop.Platform.VulkanLayer.VKIntox"
# the freedesktop branch this layer is built for; must match the flatpak manifest.
LAYER_BRANCH="26.08"
# where `just flatpak-build` leaves the local repo, per the Justfile
FLATPAK_BUILD_ROOT="build/flatpak-repo"
# caches the source hash so an unchanged tree can skip a rebuild; uninstall has
# to drop it or the next install would think the layer is still in place
LAYER_MARKER="$HOME/.local/share/VKIntox/sober-layer.sha256"

spin_pid=""

start_spin() {
    [[ ${#SPIN_FRAMES[@]} -eq 0 ]] && return
    local msg="$1"
    (
        local i=0
        while true; do
            printf "\r  ${BLUE}${SPIN_FRAMES[$((i % ${#SPIN_FRAMES[@]}))]}${NC} %s  " "$msg"
            ((i += 1))
            sleep 0.12
        done
    ) &
    spin_pid=$!
    disown $spin_pid 2>/dev/null || true
}

stop_spin() {
    if [[ -n "$spin_pid" ]]; then
        kill "$spin_pid" 2>/dev/null || true
        wait "$spin_pid" 2>/dev/null || true
        spin_pid=""
        if [[ -t 1 ]]; then
            printf "\r\033[K"
        fi
    fi
}

run_progress() {
    local label="$1"; shift
    local log status
    log=$(mktemp)
    start_spin "$label..."
    if "$@" >"$log" 2>&1; then
        stop_spin
        ok "$label"
        rm -f "$log"
    else
        status=$?
        stop_spin
        cat "$log" >&2
        rm -f "$log"
        die "$label failed (exit $status)"
    fi
}

trap 'stop_spin' EXIT

say()  { printf "${BLUE}  →${NC} %s\n" "$*"; }
ok()   { stop_spin; printf "${GREEN}  ✓${NC} %s\n" "$*"; }
warn() { stop_spin; printf "${YELLOW}  !${NC} %s\n" "$*"; }
die()  { stop_spin; printf "${RED}  ✗${NC} %s\n" "$*" >&2; exit 1; }
section() { stop_spin; printf "\n${BLUE}${B}%s${NC}\n" "$*"; }

need_cmd() {
    command -v "$1" >/dev/null 2>&1 || die "missing $1 — install it first"
}

# Uninstalling removes the layer and the repo it was served from, and nothing
# else. Shader packages, profiles and the effect list are the user's own work:
# a reinstall picks them straight back up, so there is no reason to destroy them.
uninstall_flatpak_layer() {
    need_cmd flatpak
    section "removing layer"
    if flatpak info --user "$LAYER_ID" >/dev/null 2>&1; then
        run_progress "uninstalling $LAYER_ID" flatpak uninstall --user --noninteractive -y "$LAYER_ID"
    else
        ok "layer is not installed"
    fi

    section "removing local repo"
    if flatpak remote-list --user 2>/dev/null | awk '{print $1}' | grep -qx 'vkintox-local'; then
        run_progress "removing vkintox-local" flatpak remote-remove --user vkintox-local
    else
        ok "vkintox-local remote is not configured"
    fi

    if [[ -d "$FLATPAK_BUILD_ROOT" ]]; then
        rm -rf -- "$FLATPAK_BUILD_ROOT"
        ok "removed the local build repo"
    fi
    if [[ -f "$LAYER_MARKER" ]]; then
        rm -f -- "$LAYER_MARKER"
        ok "cleared the build cache marker"
    fi
}

# root writes to the build tree during install/uninstall, and any root-owned file
# left there breaks the next unprivileged `just build`. hand them back. needs the
# sudo session from the caller; a no-op when nothing is root-owned.
reclaim_build_ownership() {
    [[ -d build ]] || return 0
    find build -user root -print0 2>/dev/null \
        | sudo -n xargs -0 -r chown "$(id -u):$(id -g)" 2>/dev/null || true
}

uninstall_system_layer() {
    # the system install wrote into /usr, so this is the one part needing root.
    section "removing system install"
    if [[ ! -d build ]]; then
        die "no build directory; run this from the project root"
    fi
    say "authenticating for system uninstall"
    sudo -v || die "could not authenticate for system uninstall"
    run_progress "removing system-wide files" sudo -n ninja -C build uninstall
    reclaim_build_ownership

    section "config kept"
    printf "  ${DIM}%s${NC}\n" "$HOME/.config/VKIntox"
    printf "  ${DIM}delete that by hand if you really want it gone${NC}\n"
}

MODE="${1:-}"
[[ -z "$MODE" ]] && { usage; exit 2; }

# "uninstall" is accepted in place of the app id, since removing a layer is not
# per-application: there is one layer and one repo regardless of who enabled it.
UNINSTALL=0
case "${2:-}" in
    uninstall | --uninstall | -u) UNINSTALL=1 ;;
esac

if [[ "$MODE" == "flatpak" && $UNINSTALL -eq 0 ]]; then
    [[ $# == 2 ]] || { usage; die "flatpak needs an app id"; }
    APP_ID="$2"
elif [[ "$MODE" == "sober" ]]; then
    APP_ID="org.vinegarhq.Sober"
else
    APP_ID=""
fi
[[ "$MODE" =~ ^(sober|flatpak|system)$ ]] || { usage; die "unknown mode: $MODE"; }

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

# uninstall needs neither just nor a shader download, so it branches before the
# install dependency check rather than failing on tools it will not use
if [[ $UNINSTALL -eq 1 ]]; then
    if [[ "$MODE" == "system" ]]; then
        uninstall_system_layer
    else
        uninstall_flatpak_layer
    fi
    printf "\n${BLUE}${B}done${NC}\n"
    printf "${B}uninstalled!!${NC}\n"
    exit 0
fi

section "dependencies"
need_cmd just
need_cmd python3
need_cmd sha256sum

if [[ "$MODE" != "system" ]]; then
    need_cmd flatpak
    need_cmd flatpak-builder
    need_cmd curl
    need_cmd unzip
    ok "tools ready"

    if flatpak remote-list --user 2>/dev/null | grep -q '^flathub'; then
        ok "flathub remote exists"
    else
        warn "adding flathub remote"
        flatpak remote-add --user --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo
    fi
else
    need_cmd meson
    need_cmd ninja
    need_cmd ccache
    need_cmd clang
    need_cmd glslangValidator
    need_cmd sudo
    need_cmd curl
    need_cmd unzip
fi

if [[ "$MODE" == "system" ]]; then
    section "system install"
    run_progress "configured" just configure

    run_progress "compiled" just build

    say "authenticating for system install"
    sudo -v || die "could not authenticate for system install"
    # `--no-rebuild`: plain `ninja install` rebuilds as root and leaves
    # root-owned objects and .ninja_log behind, which breaks `just build`
    # afterwards. already compiled above, so just copy into /usr.
    run_progress "installed to system" sudo -n meson install -C build --no-rebuild
    reclaim_build_ownership
fi

if [[ "$MODE" != "system" ]]; then
    section "flatpak sdks"

    run_progress "pulling gnome sdk" flatpak install -y --user flathub runtime/org.gnome.Sdk/x86_64/51
    flatpak info --user runtime/org.gnome.Sdk/x86_64/51 >/dev/null 2>&1 || die "gnome sdk install failed"

    run_progress "pulling freedesktop runtime" flatpak install -y --user flathub runtime/org.freedesktop.Platform/x86_64/26.08
    flatpak info --user runtime/org.freedesktop.Platform/x86_64/26.08 >/dev/null 2>&1 || die "freedesktop runtime install failed"

    run_progress "pulling freedesktop sdk" flatpak install -y --user flathub runtime/org.freedesktop.Sdk/x86_64/26.08
    flatpak info --user runtime/org.freedesktop.Sdk/x86_64/26.08 >/dev/null 2>&1 || die "freedesktop sdk install failed"

    run_progress "pulling clang" flatpak install -y --user flathub runtime/org.freedesktop.Sdk.Extension.llvm22/x86_64/26.08
    flatpak info --user runtime/org.freedesktop.Sdk.Extension.llvm22/x86_64/26.08 >/dev/null 2>&1 || die "llvm 22 sdk extension install failed"
fi

SOURCE_HASH=$(find src packaging/meson-config -type f -print0 | LC_ALL=C sort -z | xargs -0 sha256sum | sha256sum | cut -d' ' -f1)
SOURCE_HASH=$(printf '%s\n' "$SOURCE_HASH" "$(sha256sum VERSION Justfile meson.build meson_options.txt packaging/flatpak/org.freedesktop.Platform.VulkanLayer.VKIntox.json packaging/nix/flake.nix)")
SOURCE_HASH=$(printf '%s' "$SOURCE_HASH" | sha256sum | cut -d' ' -f1)

if [[ "$MODE" != "system" ]]; then
    section "building layer"
    if [[ ! -f "$LAYER_MARKER" || "$(cat "$LAYER_MARKER")" != "$SOURCE_HASH" ]] || \
       ! flatpak info --user "$LAYER_ID//$LAYER_BRANCH" >/dev/null 2>&1; then
        run_progress "building + installing layer" just flatpak-build
        mkdir -p "$(dirname "$LAYER_MARKER")"
        printf '%s\n' "$SOURCE_HASH" > "$LAYER_MARKER"
    else
        ok "layer already up to date"
    fi
else
    section "building layer"
fi

section "config dirs"
if [[ "$MODE" == "system" ]]; then
    APP_CONFIG="$HOME/.config/VKIntox"
else
    APP_CONFIG="$HOME/.var/app/$APP_ID/config/VKIntox"
fi
RESHADE_DIR="$APP_CONFIG/reshade"
SHADERS_DIR="$RESHADE_DIR/Shaders"
TEXTURES_DIR="$RESHADE_DIR/Textures"
FONT_DIR="$APP_CONFIG/font"

mkdir -p "$SHADERS_DIR" "$TEXTURES_DIR" "$FONT_DIR"
cp "$SCRIPT_DIR/VERSION" "$APP_CONFIG/version"
ok "created config dirs"

# seed the depth inversion default for the target: sober's depth buffer reads
# inverted, everything else does not. written at install time so a fresh config
# is right out of the box, and rewritten to the target default on a re-run.
DEPTH_INVERT=false
[[ "$APP_ID" == "org.vinegarhq.Sober" ]] && DEPTH_INVERT=true
python3 - "$APP_CONFIG/VKIntox.conf" "$DEPTH_INVERT" <<'PYEOF'
import os, re, sys
path, want = sys.argv[1], sys.argv[2]
lines = []
if os.path.exists(path):
    with open(path, "r", encoding="utf-8-sig") as f:
        lines = f.read().splitlines()
out = []
replaced = False
for line in lines:
    if re.match(r"\s*depthInvert\s*=", line):
        out.append(f"depthInvert = {want}")
        replaced = True
    else:
        out.append(line)
if not replaced:
    if out and out[-1].strip():
        out.append("")
    out.append("# depthInvert: invert depth values (flips near/far planes)")
    out.append(f"depthInvert = {want}")
with open(path, "w", encoding="utf-8") as f:
    f.write("\n".join(out) + "\n")
PYEOF
say "depth inversion default: $DEPTH_INVERT"

# the overlay loads the whole M3 set: regular plus the three emphasized weights,
# the Material Symbols font for icons, and font.ttf as the legacy regular
# fallback. scripts/setup mirrors this list.
for font in GoogleSans-Regular.ttf GoogleSans-Medium.ttf GoogleSans-Bold.ttf GoogleSans-ExtraBold.ttf MaterialSymbolsRounded.ttf LICENSE LICENSE-SIL-OFL-1.1.txt LICENSE-Apache-2.0.txt; do
    cp "$SCRIPT_DIR/assets/font/$font" "$FONT_DIR/" || die "missing assets/font/$font"
done
cp "$FONT_DIR/GoogleSans-Regular.ttf" "$FONT_DIR/font.ttf"
ok "installed fonts"

section "reshade shaders"
WORK_DIR=$(mktemp -d)
trap 'rm -rf "$WORK_DIR"; stop_spin' EXIT

INI_FILE="$SCRIPT_DIR/assets/EffectPackages.ini"
EFFECTS_HASH=$(sha256sum "$INI_FILE" | cut -d' ' -f1)
EFFECTS_MARKER="$RESHADE_DIR/.vkintox_effects_hash"

if [[ -f "$EFFECTS_MARKER" && "$(cat "$EFFECTS_MARKER")" == "$EFFECTS_HASH" ]]; then
    ok "effects up to date"
else
    rm -rf "$SHADERS_DIR" "$TEXTURES_DIR"
    mkdir -p "$SHADERS_DIR" "$TEXTURES_DIR"
    # the old layout nested these under reshade/packages; drop it so shader
    # discovery cannot see the same files in two places
    rm -rf "$RESHADE_DIR/packages"

    start_spin "downloading + extracting packages..."
    PACKAGE_LOG="$WORK_DIR/package-install.log"
    python3 - "$WORK_DIR" "$SHADERS_DIR" "$TEXTURES_DIR" "$INI_FILE" >"$PACKAGE_LOG" 2>&1 <<'PYEOF' || { stop_spin; cat "$PACKAGE_LOG" >&2; die "shader fetch failed"; }
import configparser, os, sys, shutil, urllib.request, zipfile

work_dir, shaders_dir, textures_dir, ini_file = sys.argv[1:5]

with open(ini_file, "r", encoding="utf-8-sig") as f:
    cfg = configparser.ConfigParser(strict=False)
    cfg.read_string(f.read())

ok = 0
failed = []

for section in cfg.sections():
    pkg = cfg[section]
    name = pkg.get("PackageName", section)
    url = pkg.get("DownloadUrl")
    if not url: continue

    # every package installs into its own directory under Shaders/ and Textures/,
    # named after its InstallPath subdir or, when it targets the shared root, the
    # first word of its PackageName
    def package_dir(configured, root, fallback):
        path = (configured or "").replace("\\", "/")
        marker = "reshade-shaders/" + root
        sub = path.split(marker, 1)[1].strip("/") if marker in path else ""
        sub = sub or fallback
        sub = "".join(c if (c.isalnum() or c in "-_.") else "_" for c in sub).strip("._")
        return sub or "package"

    fallback_dir = (pkg.get("PackageName", section).split() or [section])[0]
    sub_shader = package_dir(pkg.get("InstallPath"), "Shaders", fallback_dir)
    sub_tex = package_dir(pkg.get("TextureInstallPath"), "Textures", sub_shader)

    tgt_shaders = os.path.join(shaders_dir, sub_shader)
    tgt_textures = os.path.join(textures_dir, sub_tex)
    os.makedirs(tgt_shaders, exist_ok=True)
    os.makedirs(tgt_textures, exist_ok=True)

    effect_files = [f.strip() for f in pkg.get("EffectFiles", "").split(",") if f.strip()]
    deny_files = {f.strip() for f in pkg.get("DenyEffectFiles", "").split(",") if f.strip()}

    zip_path = os.path.join(work_dir, f"{section}.zip")
    try:
        req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
        with urllib.request.urlopen(req) as r, open(zip_path, "wb") as out:
            shutil.copyfileobj(r, out)
        with zipfile.ZipFile(zip_path) as z:
            z.extractall(os.path.join(work_dir, section))
    except Exception as e:
        failed.append(f"{name} ({e})")
        continue

    n_sh = n_tx = 0
    for root, _, files in os.walk(os.path.join(work_dir, section)):
        for fn in files:
            src = os.path.join(root, fn)
            if fn in deny_files: continue
            if fn.endswith((".fx", ".fxh")):
                if fn.endswith(".fx") and effect_files and fn not in effect_files: continue
                shutil.copy2(src, tgt_shaders); n_sh += 1
            elif fn.lower().endswith((".png", ".jpg", ".jpeg", ".dds", ".tga", ".bmp")):
                shutil.copy2(src, tgt_textures); n_tx += 1

    if n_sh == 0 and n_tx == 0:
        failed.append(f"{name} (no matching files)")
    else:
        ok += 1
        print(f"  ✓ {name}: {n_sh} shader(s), {n_tx} texture(s)")

print()
print(f"  {ok} package(s) installed")
if failed:
    print(f"  {len(failed)} package(s) had problems:")
    for f in failed:
        print(f"    - {f}")
    raise SystemExit(1)
PYEOF
    stop_spin
    cat "$PACKAGE_LOG"
    ok "shaders fetched + extracted"
    printf '%s\n' "$EFFECTS_HASH" > "$EFFECTS_MARKER"
fi

# the shader that ships with VKIntox itself, in its own VKIntox package dir
# beside the downloaded packages; refreshed every run so a fix lands without a
# package hash change
mkdir -p "$SHADERS_DIR/VKIntox"
for shader in MSAA.fx; do
    cp "$SCRIPT_DIR/assets/builtInShaders/$shader" "$SHADERS_DIR/VKIntox/$shader" ||
        die "missing assets/builtInShaders/$shader"
done
ok "installed built-in shaders"

section "shader paths"
ok "shader/texture paths setup"

if [[ "$MODE" != "system" ]]; then
    section "enable layer"
    if flatpak override --user "$APP_ID" --env=ENABLE_VKINTOX=1 2>/dev/null; then
        ok "ENABLE_VKINTOX=1 set"
    else
        warn "couldn't set override — app may not be installed yet"
        warn "after installing, run:"
        printf "    ${DIM}flatpak override --user %s --env=ENABLE_VKINTOX=1${NC}\n" "$APP_ID"
    fi
else
    section "enable layer"
    ok "enable with ENABLE_VKINTOX=1 when launching a native game"
fi

SHADER_COUNT=$(find "$SHADERS_DIR" -name '*.fx' 2>/dev/null | wc -l)
TEXTURE_COUNT=$(find "$TEXTURES_DIR" -type f 2>/dev/null | wc -l)

printf "\n${BLUE}${B}done${NC}\n"
printf "  shaders:    ${DIM}%s${NC}  (%s)\n" "$SHADER_COUNT" "$SHADERS_DIR"
printf "  textures:   ${DIM}%s${NC}  (%s)\n" "$TEXTURE_COUNT" "$TEXTURES_DIR"
printf "  packages:   ${DIM}%s${NC}\n" "$RESHADE_DIR"
printf "\n${B}setup finished!!${NC}\n"
